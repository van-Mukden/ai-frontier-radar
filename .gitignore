# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# radar data —— 提交打包好的 radar.db 供部署用，忽略 WAL/临时文件
/data/*
!/data/radar.db
.env
